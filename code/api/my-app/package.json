{
  "name": "my-app",
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 --format=cjs ./src/index.ts",
    "zip": "zip -j lambda.zip dist/index.js",
    "deploy": "npm run build && npm run zip"
  },
  "devDependencies": {
    "esbuild": "^0.21.4",
    "tsx": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/pg": "^8.0.0"
  },
  "dependencies": {
    "hono": "^4.12.8",
    "@hono/node-server": "^1.0.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "pg": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "dotenv": "^16.0.0"
  }
}
